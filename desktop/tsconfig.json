{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "react",
      "react-dom"
    ],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "*.ts",
    "*.tsx"
  ]
}
